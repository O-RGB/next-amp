{
  "name": "nextstudio",
  "version": "1.0.0",
  "description": "NextStudio - Pitch Shifter, AI Vocal & Video Sync",
  "dependencies": {
    "qrcode-generator": "1.4.4"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:extension:store",
    "build:web": "node scripts/build-web.js",
    "build:extension": "npm run build:extension:store",
    "build:extension:store": "npm run audit:copyright && node scripts/build-prod.js --profile=store",
    "build:extension:go-dev": "node scripts/build-prod.js --profile=go-dev",
    "verify:extension:store": "node scripts/verify-extension-artifact.js --profile=store",
    "test:review": "node scripts/test-review-readiness.mjs",
    "audit:copyright": "node scripts/audit-copyright-provenance.mjs",
    "verify:extension:go-dev": "node scripts/verify-extension-artifact.js --profile=go-dev",
    "build:go": "bash nextstudio-engine-go/build.sh",
    "build:public-site": "node scripts/build-public-site.js",
    "build:all-internal": "npm run build:web && npm run build:extension:store && npm run build:extension:go-dev && npm run build:public-site",
    "model:fetch": "bash nextstudio-model-builder/scripts/build.sh --fetch-only",
    "model:build": "bash nextstudio-model-builder/scripts/build.sh",
    "model:verify": "bash nextstudio-model-builder/scripts/verify.sh",
    "model:deploy": "bash nextstudio-model-builder/scripts/deploy.sh",
    "model:build:deploy": "npm run model:build && npm run model:verify && npm run model:deploy"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^5.6.0",
    "tailwindcss": "3.4.17"
  }
}
