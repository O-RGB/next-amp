{
  "manifest_version": 3,
  "name": "Nextamp Extension",
  "version": "4.6",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "assets/logo.png"
  },
  "icons": {
    "128": "assets/logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/libs/mjs/SignalsmithStretch.mjs",
        "assets/libs/js/tailwindcss.js",
        "assets/css/phosphor.css",
        "assets/fonts/Phosphor-Bold.woff2",
        "assets/libs/js/peerjs.min.js",
        "assets/libs/js/tf.min.js",
        "modules/ai-vocal/vocal-worklet.js",
        "modules/ai-vocal/vocal-worker.js",
        "modules/ai-vocal/stft_simd.wasm",
        "modules/ai-vocal/stft_scalar.wasm",
        "model/model.json",
        "model/group1-shard1of1.bin",
        "remote/dos-remote.html",
        "debug-ai.html",
        "debug-ai.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["video-delay.js", "video-zoom.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://*.peerjs.com wss://*.peerjs.com https://da.gd https://spoo.me; img-src 'self' data: https://api.qrserver.com"
  }
}
