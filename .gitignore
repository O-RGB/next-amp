/ai remove
dist/
node_modules/
.DS_Store

# Local HTTPS development certificates (never commit private keys)
cert.pem
key.pem

# Go native engine: local build outputs
nextsona-engine-go/nextsona-engine
nextsona-engine-go/nextsona-engine.exe
nextsona-engine-go/nextsona-engine-go

# Go native engine: large local packaging inputs
# The compressed/encrypted files under nextsona-engine-go/assets/ are kept
# because they are required by go:embed at runtime/build time.
nextsona-engine-go/*.onnx
nextsona-engine-go/*.dylib
nextsona-engine-go/*.dll

# Local session metadata
nextsona-engine-go/:memory:.ses
# ONNX Runtime telemetry scratch file (ORT 1.30+)
:memory:.ses
