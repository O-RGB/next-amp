/ai remove
dist/
node_modules/
.DS_Store

# Local HTTPS development certificates (never commit private keys)
cert.pem
key.pem

# Go native engine: local build outputs
nextstudio-engine-go/nextstudio-engine
nextstudio-engine-go/nextstudio-engine.exe
nextstudio-engine-go/nextstudio-engine-go

# Go native engine: large local packaging inputs
# The compressed/encrypted files under nextstudio-engine-go/assets/ are kept
# because they are required by go:embed at runtime/build time.
nextstudio-engine-go/*.onnx
nextstudio-engine-go/*.dylib
nextstudio-engine-go/*.dll

# Local session metadata
nextstudio-engine-go/:memory:.ses
# ONNX Runtime telemetry scratch file (ORT 1.30+)
:memory:.ses
